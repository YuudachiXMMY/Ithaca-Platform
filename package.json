{
	"name": "ithaca-fa-web-kit",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"start": "node build/index.js",
		"prepare": "svelte-kit sync && paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide || echo ''",
		"check": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"test": "vitest run",
		"test:watch": "vitest",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "eslint . && prettier --check .",
		"format": "prettier --write .",
		"db:migrate": "prisma migrate dev",
		"db:migrate:deploy": "prisma migrate deploy",
		"db:migrate:status": "prisma migrate status",
		"db:migrate:reset": "prisma migrate reset",
		"db:seed": "tsx prisma/seed.ts",
		"db:studio": "prisma studio",
		"prisma:seed": "tsx prisma/seed.ts",
		"postinstall": "if [ -f prisma/schema.prisma ]; then prisma generate; fi",
		"lhci": "npx --yes @lhci/cli@0.15.x autorun",
		"prod": "bash scripts/prod.sh",
		"prod:deploy": "bash scripts/prod.sh deploy",
		"prod:logs": "bash scripts/prod.sh logs",
		"prod:status": "bash scripts/prod.sh status",
		"prod:backup": "bash scripts/prod.sh backup",
		"prod:rollback": "bash scripts/prod.sh rollback"
	},
	"prisma": {
		"seed": "tsx prisma/seed.ts"
	},
	"dependencies": {
		"@fontsource/noto-sans-sc": "^5.3.0",
		"@fontsource/outfit": "^5.3.0",
		"@prisma/client": "^6.19.3",
		"@threlte/core": "^8.6.0",
		"@threlte/extras": "^9.21.1",
		"@upstash/ratelimit": "^2.0.8",
		"@upstash/redis": "^1.38.0",
		"bcryptjs": "^3.0.3",
		"better-auth": "1.7.2",
		"clsx": "^2.1.1",
		"gsap": "^3.15.0",
		"lucide-svelte": "^1.0.1",
		"nodemailer": "^9.0.6",
		"three": "^0.185.1",
		"zod": "^4.3.6"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.24.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/enhanced-img": "^0.11.0",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^22",
		"@types/nodemailer": "^8.0.1",
		"@types/three": "^0.185.4",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"prisma": "^6.19.3",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.20.6",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16",
		"vitest": "^4.1.11"
	}
}
