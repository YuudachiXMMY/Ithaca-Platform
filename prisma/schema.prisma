generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Subscriber {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  status       String   @default("active") // active, unsubscribed
  subscribedAt DateTime @default(now()) @map("subscribed_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("subscribers")
}

/// A contact-form submission. The redesign turns this into a qualified *enquiry*: the PRD's
/// hypothesis is that Chinese-speaking parents convert when they can say which programme and
/// which grade in their own language, and none of that could be recorded before.
///
/// `prd.md` §12.1 sketches a separate `Inquiry` model; the redesign PRD overrides that in favour
/// of extending this one, so the existing rows, the admin contacts page and the API keep working.
///
/// Every field below is ADDITIVE — nullable or defaulted — on purpose. The container CMD runs
/// `prisma migrate deploy` on boot, so this migration applies to production automatically on the
/// next `-kit` rollout, unattended, against live data. A required column or an altered type would
/// fail that boot. Take `npm run prod:backup` first regardless.
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  message   String?
  subscribe Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  /// Locale the enquiry was written in ('en' | 'zh'). Drives which language the confirmation
  /// email is sent in, and is the only way to measure the PRD's `/zh` conversion hypothesis.
  locale    String?
  /// Student grade, 4–12. `prd.md` R-CON-1 makes it optional: the market evidence in the PRD is
  /// that every extra required field costs completions, so qualification must not become a wall.
  grade     Int?
  /// Programme slugs the family is interested in. Defaults to empty rather than null so callers
  /// never have to distinguish "asked for nothing" from "field did not exist yet".
  programs  String[] @default([])
  /// 'program' | 'join' | 'general' — set from the `?topic=` query param (R-ABOUT-7 links here).
  topic     String?
  /// How they heard about us. Free text; the WeChat channel is invisible in analytics otherwise.
  source    String?
  /// 'new' | 'contacted' | 'closed'. Defaulted so every existing row reads as untriaged, which
  /// is what it is.
  status    String   @default("new")
  /// Staff triage notes.
  notes     String?

  /// The admin list sorts by createdAt and will filter by status; neither column was indexed.
  @@index([createdAt])
  @@index([status])
  @@map("contact_messages")
}

model EmailCampaign {
  id             String          @id @default(cuid())
  subject        String
  body           String
  status         String          @default("draft") // draft, sending, sent, failed
  recipientCount Int             @default(0) @map("recipient_count")
  sentAt         DateTime?       @map("sent_at") @db.Timestamptz(3)
  createdAt      DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)
  deliveries     EmailDelivery[]

  @@map("email_campaigns")
}

// Retry-idempotency ledger (DEF-1): one row per (campaign, recipient) that was successfully
// sent. The send handler filters already-delivered recipients before each batch, so a
// mid-send failure + retry delivers only to the un-recorded remainder — never re-blasting.
model EmailDelivery {
  id         String        @id @default(cuid())
  campaignId String        @map("campaign_id")
  campaign   EmailCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  email      String
  sentAt     DateTime      @default(now()) @map("sent_at") @db.Timestamptz(3)

  @@unique([campaignId, email])
  @@map("email_deliveries")
}

model Popup {
  id           String    @id @default(cuid())
  title        String
  content      String
  buttonText   String?   @map("button_text")
  buttonLink   String?   @map("button_link")
  isActive     Boolean   @default(false) @map("is_active")
  startDate    DateTime? @map("start_date") @db.Timestamptz(3)
  endDate      DateTime? @map("end_date") @db.Timestamptz(3)
  displayRules String?   @map("display_rules") // JSON: { pages: [], frequency: "once"|"session"|"always" }
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("popups")
}

// --- Better Auth tables (Phase 3) ---
// Generated shape for @better-auth/cli v1.7.x (PostgreSQL). `id` has no @default —
// Better Auth supplies ids in the app layer; the seed/migration scripts pass id explicitly.
// The credential password (bcrypt hash) lives on Account.password (providerId 'credential').

model User {
  id            String    @id
  name          String
  email         String    @unique
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @db.Timestamptz(3)
  sessions      Session[]
  accounts      Account[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime @db.Timestamptz(3)
  token     String   @unique
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  issuer                String
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(3)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(3)
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime  @updatedAt @db.Timestamptz(3)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(3)
  createdAt  DateTime @default(now()) @db.Timestamptz(3)
  updatedAt  DateTime @updatedAt @db.Timestamptz(3)

  @@map("verification")
}
