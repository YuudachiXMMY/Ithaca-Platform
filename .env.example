# --- Database (Prisma / PostgreSQL) ---
DATABASE_URL="postgresql://ithacafa:ithacafa_dev_2026@localhost:5432/ithacafa"

# --- Admin seed (prisma/seed.ts) ---
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# --- Analytics (public; inlined at build time) ---
PUBLIC_GA_TRACKING_ID="G-675W5PPJEJ"
# Canonical site origin for SEO (absolute canonical/OG/hreflang URLs + sitemap).
# Must be present BEFORE `vite build` — inlined via $env/static/public.
PUBLIC_SITE_URL="https://ithacateens.com"

# --- adapter-node behind Cloudflare ---
ORIGIN="http://localhost:3000"
ADDRESS_HEADER="cf-connecting-ip"
PROTOCOL_HEADER="x-forwarded-proto"
HOST_HEADER="x-forwarded-host"
BODY_SIZE_LIMIT="5M"
# PORT=3000
# HOST=0.0.0.0

# --- Auth (Better Auth) ---
# Server-only secrets. BETTER_AUTH_SECRET signs sessions (required in production).
BETTER_AUTH_SECRET="generate-a-long-random-secret"
# Canonical public origin (correct cookies/redirects behind the reverse proxy).
BETTER_AUTH_URL="http://localhost:3000"

# --- Email (nodemailer SMTP — Stalwart mail server) ---
# Unset in dev = graceful no-op (sends are skipped, forms still succeed).
# Prod: set these as RUNTIME env in the server-side .prod.env (ops deploy), NOT Docker build-args.
# Provision the sending domain + a noreply account + an app-password in Stalwart admin first.
# SMTP_HOST="mail.ithacateens.com"   # public submission host; TLS cert matches this name.
#                                    # On the IthacaServer deploy, use the internal alias `stalwart`
#                                    # (same Docker network) + SMTP_TLS_INSECURE=1 (see below).
# SMTP_PORT="465"                    # 465 = implicit TLS; 587 is refused on the internal path
# SMTP_USER="noreply@ithacateens.com"# full-email account on a Stalwart-registered domain
# SMTP_PASSWORD=""                   # Stalwart app-password (Account > App Passwords), NOT the login pw
# SMTP_FROM="Ithaca Family Academy <noreply@ithacateens.com>"
# SMTP_TLS_INSECURE=""               # "1" to keep TLS on but skip cert verification — ONLY for the
#                                    # internal `stalwart` host, whose cert never matches that alias.
#                                    # Leave unset when SMTP_HOST is the public mail.<domain>.

# --- Rate limit (optional Upstash Redis) ---
# Unset = in-memory sliding-window limiter (fine for a single instance).
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""

# --- Enquiry routing (redesign) ---
# Where contact-form submissions are emailed. Replaces the hardcoded staff address that used to
# live in src/routes/api/contact/+server.ts. Unset falls back to that address so a deploy that
# forgets this does not silently drop enquiries.
INQUIRY_TO="info@ithacateens.com"

# --- Cloudflare Turnstile (optional) ---
# Bot protection on the public form POSTs. UNSET = verification is skipped and the form still
# works (same graceful-degradation contract as SMTP above) — dev needs no keys.
# The site key is PUBLIC and is inlined into the client bundle at BUILD time, so it must be
# present before `vite build`, like the other PUBLIC_* values. The secret is runtime-only and
# must never be given a PUBLIC_ prefix.
# PUBLIC_TURNSTILE_SITE_KEY=""
# TURNSTILE_SECRET_KEY=""

# --- Consultation booking (optional) ---
# Google Calendar appointment schedule or Cal.com link for /admissions#book. UNSET = that section
# degrades to the contact form (prd.md R-ADM-6), which is the current state — no link supplied yet.
#
# PUBLIC_, and therefore inlined at BUILD time (like PUBLIC_TURNSTILE_SITE_KEY above). prd.md §18
# lists this as a runtime `BOOKING_URL`; that cannot work, because /admissions is PRERENDERED — it
# ships as a static HTML file, so nothing the container's environment says at boot can change what
# that file contains, and a non-PUBLIC_ variable is not readable from a page component at all.
# Build-time is when this decision is actually made, so this is the name that tells the truth.
# Must be present before `vite build`; in Docker/CI pass it as a build-arg like the other PUBLIC_*.
# PUBLIC_BOOKING_URL=""
