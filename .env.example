# --- Database (Prisma / PostgreSQL) ---
DATABASE_URL="postgresql://ithacafa:ithacafa_dev_2026@localhost:5432/ithacafa"

# --- Admin seed (prisma/seed.ts) ---
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# --- Analytics (public; inlined at build time) ---
# Renamed from NEXT_PUBLIC_GA_TRACKING_ID -> PUBLIC_GA_TRACKING_ID (SvelteKit PUBLIC_ prefix)
PUBLIC_GA_TRACKING_ID="G-675W5PPJEJ"
# Canonical site origin for SEO (absolute canonical/OG/hreflang URLs + sitemap).
# Must be present BEFORE `vite build` — inlined via $env/static/public.
PUBLIC_SITE_URL="https://ithacateens.com"

# --- adapter-node behind Cloudflare (production start) ---
ORIGIN="http://localhost:3000"
ADDRESS_HEADER="cf-connecting-ip"
PROTOCOL_HEADER="x-forwarded-proto"
HOST_HEADER="x-forwarded-host"
BODY_SIZE_LIMIT="5M"
# PORT=3000
# HOST=0.0.0.0

# --- Auth (Better Auth, Phase 3) ---
# Server-only secrets. BETTER_AUTH_SECRET signs sessions (required in production).
# May reuse the old NEXTAUTH_SECRET value during transition (cutover forces one re-login).
BETTER_AUTH_SECRET="generate-a-long-random-secret"
# Canonical public origin (correct cookies/redirects behind the reverse proxy).
BETTER_AUTH_URL="http://localhost:3000"

# --- Email (nodemailer SMTP, Phase 3) ---
# Unset in dev = graceful no-op (sends are skipped, forms still succeed).
# SMTP_HOST=""
# SMTP_PORT="587"           # 465 = implicit TLS, 587 = STARTTLS
# SMTP_USER=""
# SMTP_PASSWORD=""
# SMTP_FROM="Ithaca Family Academy <noreply@ithacateens.com>"

# --- Rate limit (optional Upstash Redis, Phase 3) ---
# Unset = in-memory sliding-window limiter (fine for a single instance).
# UPSTASH_REDIS_REST_URL=""
# UPSTASH_REDIS_REST_TOKEN=""
